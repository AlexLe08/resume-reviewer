# Get a free key at https://aistudio.google.com (no card required).
# Copy this file to .env.local and fill it in. Never commit .env.local.
GEMINI_API_KEY=

# Check AI Studio for which models are currently on the free tier.
GEMINI_MODEL=gemini-3.5-flash

# Paid-tier prices in USD per million tokens. Used only to ESTIMATE what a review
# would cost at paid rates. Leave at 0 while you're on the free tier.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0

LLM_PROVIDER=ollama

OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
